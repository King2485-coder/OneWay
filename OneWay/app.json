{
  "expo": {
    "name": "OneWay",
    "slug": "oneway",
    "version": "0.1.0",
    "scheme": "oneway",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06030f",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#06030f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.oneway.client",
      "associatedDomains": ["applinks:oneway.app"],
      "infoPlist": {
        "NSCameraUsageDescription": "OneWay uses the camera so you can add photos to your private site.",
        "NSPhotoLibraryUsageDescription": "OneWay uses your photo library so you can add images to your site."
      }
    },
    "android": {
      "package": "app.oneway.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06030f"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "https", "host": "*.oneway.app" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [],
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}
