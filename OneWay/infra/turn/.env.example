# OneWay TURN server — copy to .env and fill in real values.
# DO NOT commit .env. The .gitignore at the repo root already excludes it.

# Public IPv4 of the VPS coturn runs on. Used by deploy.sh's firewall step
# and as a sanity check during health probes.
TURN_PUBLIC_IP=REPLACE_WITH_VPS_PUBLIC_IP

# Hostname pointed at TURN_PUBLIC_IP via DNS A record.
TURN_HOSTNAME=turn.oneway.app

# The HMAC secret coturn uses to verify ephemeral credentials. Must match
# the value in turnserver.conf and on the Express backend (TURN_SHARED_SECRET).
# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=REPLACE_WITH_64_HEX_CHARS

# UDP relay port range. Keep in sync with turnserver.conf and ufw rules.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Email used for Let's Encrypt registration / expiry notices.
LE_EMAIL=ops@oneway.app
