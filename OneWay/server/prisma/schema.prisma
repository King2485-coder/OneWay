// OneWay Prisma schema.
//
// Local dev default: SQLite (fast, zero-config, persistent on disk).
// Production: switch the datasource provider to "postgresql" and set
// DATABASE_URL to a real Postgres connection string, then run:
//   npx prisma migrate deploy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  email                 String?   @unique
  /// bcrypt hash. Nullable while we phase out dev tokens; required for
  /// real auth flows once `JWT_AUTH_REQUIRED=true`.
  passwordHash          String?
  displayName           String
  chirpId               String?   @unique
  chirpIdNormalized     String?   @unique
  chirpIdCreatedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accountStatus         String    @default("active")
  loginDisabledAt       DateTime?
  publicProfileHiddenAt DateTime?
  passwordChangedAt     DateTime?

  storefronts            Storefront[]
  conversations          ConversationParticipant[]
  callsAsCaller          Call[]                    @relation("CallerCalls")
  callsAsCallee          Call[]                    @relation("CalleeCalls")
  callHistory            CallHistoryEntry[]
  pushTokens             PushToken[]
  voicemailsIn           Voicemail[]               @relation("VoicemailCallee")
  voicemailsOut          Voicemail[]               @relation("VoicemailCaller")
  orders                 Order[]
  numbers                UserNumber[]
  subscriptions          Subscription[]
  sellerEntitlements     SellerEntitlement[]
  sellerPlanTransactions SellerPlanTransaction[]
  identity               OneWayIdentity?
  walkiePrivacy          WalkiePrivacySettings?
  businessPresence       BusinessPresence?
  sites                  Site[]
  siteMediaAssets        SiteMediaAsset[]
  sitePublications       SitePublication[]
  storeInquiries         StoreInquiry[]
  storeNotifications     StoreNotification[]
  storeOrderRequests     StoreOrderRequest[]
  storeEmailMessages     StoreEmailMessage[]
  storeAnalyticsEvents   StoreAnalyticsEvent[]
  emailMailbox           EmailMailbox?
  alertPushTokens        AlertPushToken[]
  passwordResetTokens    PasswordResetToken[]
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AlertPushToken {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  environment String
  previewMode String   @default("sender_subject")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model EmailMailbox {
  id        String   @id @default(uuid())
  userId    String   @unique
  address   String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads        EmailThread[]
  messages       EmailMessage[]
  blockedSenders EmailBlockedSender[]
  labels         EmailLabel[]
}

model EmailThread {
  id             String   @id @default(uuid())
  mailboxId      String
  subjectPreview String   @default("")
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mailbox  EmailMailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@index([mailboxId, lastMessageAt])
}

model EmailMessage {
  id                String    @id @default(uuid())
  threadId          String
  mailboxId         String
  providerMessageId String?
  direction         String
  folder            String
  fromJson          String
  toJson            String
  ccJson            String    @default("[]")
  bccJson           String    @default("[]")
  subject           String    @default("")
  bodyText          String    @default("")
  bodyHtml          String?
  status            String
  isRead            Boolean   @default(false)
  isStarred         Boolean   @default(false)
  spamScore         Float?
  headersJson       String?
  sentAt            DateTime?
  receivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  thread         EmailThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mailbox        EmailMailbox         @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  attachments    EmailAttachment[]
  deliveryEvents EmailDeliveryEvent[]
  messageLabels  EmailMessageLabel[]

  @@unique([mailboxId, providerMessageId])
  @@index([mailboxId, folder, createdAt])
}

model EmailAttachment {
  id          String   @id @default(uuid())
  messageId   String
  filename    String
  contentType String
  storageKey  String   @unique
  bytes       Int
  createdAt   DateTime @default(now())

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model EmailBlockedSender {
  id              String   @id @default(uuid())
  mailboxId       String
  senderHash      String
  senderEncrypted String
  createdAt       DateTime @default(now())

  mailbox EmailMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, senderHash])
}

model EmailLabel {
  id        String   @id @default(uuid())
  mailboxId String
  name      String
  color     String   @default("purple")
  createdAt DateTime @default(now())

  mailbox       EmailMailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  messageLabels EmailMessageLabel[]

  @@unique([mailboxId, name])
}

model EmailMessageLabel {
  messageId String
  labelId   String
  createdAt DateTime @default(now())

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  label   EmailLabel   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([messageId, labelId])
}

model EmailWebhookReceipt {
  token     String   @id
  provider  String
  createdAt DateTime @default(now())
}

model EmailDeliveryEvent {
  id               String   @id
  messageId        String?
  provider         String
  eventType        String
  recipientHash    String?
  detailsEncrypted String?
  createdAt        DateTime @default(now())

  message EmailMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
}

model EmailSuppressionEntry {
  id                 String   @id @default(uuid())
  recipientHash      String   @unique
  recipientEncrypted String
  reason             String
  provider           String
  createdAt          DateTime @default(now())
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorId      String?
  actorType    String
  action       String
  resourceType String
  resourceId   String?
  metadataJson String   @default("{}")
  prevHash     String?
  eventHash    String   @unique
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorType, action, createdAt])
  @@index([resourceType, resourceId])
}

model SecurityCheckRun {
  id          String   @id @default(uuid())
  checkType   String
  status      String
  severity    String
  summary     String
  detailsJson String   @default("{}")
  startedAt   DateTime
  finishedAt  DateTime

  @@index([checkType, finishedAt])
  @@index([severity, finishedAt])
  @@index([status, finishedAt])
}

model OneWayIdentity {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  displayName             String?
  walkieName              String?
  username                String?
  usernameHidden          Boolean  @default(true)
  onewayId                String   @unique
  emailAlias              String   @unique
  showEmailAlias          Boolean  @default(false)
  showOneWayId            Boolean  @default(true)
  showNumbers             Boolean  @default(false)
  preferredCallerIdentity String   @default("onewayId")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@index([username])
}

model UserNumber {
  id        String   @id @default(uuid())
  userId    String
  number    String   @unique
  label     String?
  isPrimary Boolean  @default(false)
  isPaid    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary])
  @@index([userId, createdAt])
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  productId String
  status    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([productId])
}

model SellerPackage {
  id                String    @id @default(uuid())
  code              String    @unique
  displayName       String
  description       String
  packageType       String
  billingType       String
  quantity          Int?
  priceAmount       Float
  currency          String    @default("USD")
  active            Boolean   @default(true)
  sortOrder         Int       @default(0)
  externalProductId String?
  externalPriceId   String?
  appStoreProductId String?
  startsAt          DateTime?
  endsAt            DateTime?
  metadata          String    @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([packageType, billingType])
}

model SellerEntitlement {
  id                String    @id @default(uuid())
  userId            String
  entitlementType   String
  sourceType        String
  sourceReferenceId String?
  quantity          Int       @default(0)
  startsAt          DateTime  @default(now())
  expiresAt         DateTime?
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([entitlementType])
  @@index([expiresAt])
}

model SellerPlanTransaction {
  id                    String    @id @default(uuid())
  userId                String
  packageId             String
  transactionType       String
  billingProvider       String
  providerTransactionId String?   @unique
  providerCustomerId    String?
  idempotencyKey        String    @unique
  amount                Float
  currency              String    @default("USD")
  paymentStatus         String    @default("CREATED")
  entitlementStatus     String    @default("PENDING")
  refundedAmount        Float     @default(0)
  purchasedAt           DateTime?
  effectiveAt           DateTime?
  expiresAt             DateTime?
  metadata              String    @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([paymentStatus])
  @@index([transactionType])
}

model CallSession {
  id                    String    @id @default(uuid())
  roomName              String    @unique
  callerUserId          String
  calleeUserId          String
  networkType           String    @default("oneWayNative")
  callerRole            String?
  calleeRole            String?
  provider              String?
  providerCallId        String?
  twilioCallSid         String?
  sipParticipantId      String?
  mediaBridgeStatus     String?
  externalPhoneNumber   String?
  callerOneWayNumber    String?
  destinationNumber     String?
  callerLiveKitIdentity String?
  pstnLiveKitIdentity   String?
  callerCallKitUUID     String?
  fromIdentity          String?
  fromNumber            String?
  toIdentity            String?
  toNumber              String?
  status                String    @default("ringing")
  failureReason         String?
  startedAt             DateTime  @default(now())
  answeredAt            DateTime?
  endedAt               DateTime?
  endedReason           String?

  @@index([callerUserId, startedAt])
  @@index([calleeUserId, startedAt])
  @@index([status])
  @@index([providerCallId])
  @@index([twilioCallSid])
  @@index([sipParticipantId])
  @@index([networkType, startedAt])
}

model OneWayNetworkEvent {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  target    String?
  // Keep as String for SQLite parity in local dev. Production Postgres can
  // migrate this to Json later without changing the event model shape.
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// ---------- Calling subsystem (replaces in-memory CallRegistry source-of-truth)

model Call {
  id         String    @id @default(uuid())
  callerId   String
  calleeId   String
  /// "ringing" | "accepted" | "ended" | "declined" | "missed" | "failed"
  status     String
  roomName   String
  hasVideo   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  endedAt    DateTime?

  caller     User               @relation("CallerCalls", fields: [callerId], references: [id], onDelete: Cascade)
  callee     User               @relation("CalleeCalls", fields: [calleeId], references: [id], onDelete: Cascade)
  history    CallHistoryEntry[]
  voicemails Voicemail[]

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([roomName])
}

model CallHistoryEntry {
  id              String   @id @default(uuid())
  callId          String
  userId          String
  /// "incoming" | "outgoing"
  direction       String
  /// "completed" | "missed" | "declined" | "failed"
  status          String
  durationSeconds Int      @default(0)
  hasVideo        Boolean  @default(false)
  createdAt       DateTime @default(now())
  voicemailId     String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  call      Call       @relation(fields: [callId], references: [id], onDelete: Cascade)
  voicemail Voicemail? @relation(fields: [voicemailId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([callId])
}

model Voicemail {
  id              String   @id @default(uuid())
  callId          String
  callerId        String
  calleeId        String
  /// Object storage key (S3/R2). Reads go through a signed URL; the URL
  /// itself is never persisted — we mint per-request.
  storageKey      String
  durationSeconds Int      @default(0)
  mimeType        String
  bytes           Int      @default(0)
  listened        Boolean  @default(false)
  createdAt       DateTime @default(now())

  call    Call               @relation(fields: [callId], references: [id], onDelete: Cascade)
  caller  User               @relation("VoicemailCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee  User               @relation("VoicemailCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  history CallHistoryEntry[]

  @@index([calleeId, createdAt])
}

model PushToken {
  id          String   @id @default(uuid())
  userId      String
  voipToken   String   @unique
  /// "sandbox" | "production"
  environment String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalkiePrivacySettings {
  id                               String   @id @default(uuid())
  userId                           String   @unique
  allowFriends                     Boolean  @default(true)
  allowFriendsOfFriends            Boolean  @default(false)
  allowAnyone                      Boolean  @default(true)
  allowDirectChirp                 Boolean  @default(true)
  directChirpAudience              String   @default("everyone")
  askBeforeConnecting              Boolean  @default(true)
  allowRepeatChirps                Boolean  @default(false)
  silenceUnknownChirps             Boolean  @default(true)
  requireVerifiedAccount           Boolean  @default(false)
  hideProfilePhotoFromUnknownUsers Boolean  @default(false)
  blockUnknownDuringDnd            Boolean  @default(true)
  autoBlockRepeatedAbuse           Boolean  @default(true)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DirectChirpRequest {
  id                 String    @id @default(uuid())
  senderUserId       String
  recipientUserId    String
  senderChirpId      String
  recipientChirpId   String
  status             String    @default("pending")
  clientRequestId    String
  sourceDeviceId     String?
  notificationSentAt DateTime?
  pushNotificationId String?
  channelId          String?
  abuseScore         Int       @default(0)
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  acceptedAt         DateTime?
  declinedAt         DateTime?
  ignoredAt          DateTime?
  blockedAt          DateTime?
  cancelledAt        DateTime?
  updatedAt          DateTime  @updatedAt

  @@unique([senderUserId, recipientUserId, clientRequestId])
  @@index([recipientUserId, status, createdAt])
  @@index([senderUserId, status, createdAt])
  @@index([channelId])
}

model ChirpTrustPermission {
  id              String   @id @default(uuid())
  ownerUserId     String
  permittedUserId String
  permission      String   @default("oneTime")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ownerUserId, permittedUserId])
  @@index([ownerUserId, permission])
  @@index([permittedUserId])
}

model OneWayContact {
  id            String    @id @default(uuid())
  userId        String
  contactUserId String
  status        String    @default("pending")
  direction     String    @default("outgoing")
  nickname      String?
  acceptedAt    DateTime?
  removedAt     DateTime?
  blockedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, contactUserId])
  @@index([userId, status])
  @@index([contactUserId, status])
}

model Friendship {
  id              String    @id @default(uuid())
  requesterUserId String
  recipientUserId String
  pairKey         String    @unique
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  acceptedAt      DateTime?
  deniedAt        DateTime?
  ignoredAt       DateTime?
  declinedAt      DateTime?
  blockedAt       DateTime?
  removedAt       DateTime?

  @@index([requesterUserId])
  @@index([recipientUserId])
  @@index([status])
  @@index([recipientUserId, status])
  @@index([requesterUserId, status])
}

model WalkieFavorite {
  id            String   @id @default(uuid())
  userId        String
  contactUserId String
  createdAt     DateTime @default(now())

  @@unique([userId, contactUserId])
  @@index([userId, createdAt])
  @@index([contactUserId])
}

model BusinessPresence {
  id                    String   @id @default(uuid())
  userId                String   @unique
  businessName          String   @default("")
  industry              String   @default("")
  publicPhoneNumber     String   @default("")
  businessHours         String   @default("")
  greeting              String   @default("")
  missedCallAutoReply   String   @default("")
  aiReceptionistEnabled Boolean  @default(false)
  planId                String   @default("")
  smsStatus             String   @default("notConfigured")
  voiceStatus           String   @default("notConfigured")
  setupStep             String   @default("businessIdentity")
  onboardingProgress    Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Site {
  id                  String    @id @default(uuid())
  userId              String
  domain              String
  title               String    @default("")
  description         String    @default("")
  mode                String    @default("nocode")
  html                String    @default("")
  blocksJson          String    @default("[]")
  aiPrompt            String    @default("")
  publishedHtml       String    @default("")
  publishedAt         DateTime?
  slug                String?
  publicAddress       String?
  visibility          String    @default("PUBLIC")
  status              String    @default("DRAFT")
  activePublicationId String?
  draftVersion        Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAssets  SiteMediaAsset[]
  publications SitePublication[]

  @@unique([userId, domain])
  @@unique([slug])
  @@index([domain])
  @@index([status, visibility])
  @@index([userId, updatedAt])
}

model SiteMediaAsset {
  id                   String    @id @default(uuid())
  siteId               String
  ownerId              String
  mediaType            String    @default("IMAGE")
  storageKey           String
  originalStorageKey   String?
  processedStorageKey  String?
  thumbnailStorageKey  String?
  playbackManifestKey  String?
  originalFileName     String
  mimeType             String
  sourceMimeType       String?
  outputMimeType       String?
  width                Int?
  height               Int?
  durationMilliseconds Int?
  fileSizeBytes        Int
  checksum             String
  uploadStatus         String    @default("UPLOADED")
  processingStatus     String    @default("READY")
  publicStatus         String    @default("PRIVATE")
  failureCode          String?
  failureMessage       String?
  altText              String    @default("")
  caption              String    @default("")
  focalPointX          Float     @default(0.5)
  focalPointY          Float     @default(0.5)
  variantsJson         String    @default("{}")
  usageCount           Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  site  Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([siteId, processingStatus])
  @@index([siteId, mediaType])
  @@index([uploadStatus])
  @@index([ownerId, createdAt])
  @@index([publicStatus])
}

model SitePublication {
  id                 String    @id @default(uuid())
  siteId             String
  versionNumber      Int
  status             String    @default("BUILDING")
  publishedBy        String
  publishedAt        DateTime?
  sourceDraftVersion Int       @default(1)
  contentManifest    String
  assetManifest      String
  publicAddress      String
  buildStartedAt     DateTime?
  buildCompletedAt   DateTime?
  failureCode        String?
  failureMessage     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  site      Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  publisher User @relation(fields: [publishedBy], references: [id], onDelete: Cascade)

  @@unique([siteId, versionNumber])
  @@index([siteId, status])
  @@index([publicAddress])
}

model StoreInquiry {
  id                     String    @id @default(uuid())
  userId                 String
  domain                 String
  productId              String?
  customerName           String    @default("")
  customerEmail          String    @default("")
  customerPhone          String    @default("")
  productName            String    @default("")
  productPaymentLinkUrl  String?
  message                String
  quantity               Int       @default(1)
  fulfillmentPreference  String    @default("")
  status                 String    @default("new")
  ownerReply             String    @default("")
  replyProvider          String?
  replyProviderMessageId String?
  replyStatus            String?
  repliedAt              DateTime?
  convertedAt            DateTime?
  orderRequestNote       String    @default("")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, domain, createdAt])
  @@index([domain, createdAt])
  @@index([status, createdAt])
}

model StoreNotification {
  id                    String    @id @default(uuid())
  userId                String
  domain                String
  type                  String
  title                 String
  body                  String
  status                String    @default("unread")
  relatedInquiryId      String?
  relatedOrderRequestId String?
  createdAt             DateTime  @default(now())
  readAt                DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, domain, createdAt])
  @@index([userId, status, createdAt])
}

model StoreOrderRequest {
  id                     String    @id @default(uuid())
  userId                 String
  domain                 String
  inquiryId              String?
  productId              String?
  customerName           String    @default("")
  customerEmail          String    @default("")
  customerPhone          String    @default("")
  productName            String    @default("")
  paymentMode            String    @default("contact")
  paymentLinkUrl         String?
  paymentStatus          String    @default("not_requested")
  paidAt                 DateTime?
  walletPaymentStatus    String    @default("not_started")
  walletPaymentId        String?
  buyerWalletUserId      String?
  sellerWalletUserId     String?
  walletPaidAt           DateTime?
  walletRefundedAt       DateTime?
  message                String
  quantity               Int       @default(1)
  fulfillmentPreference  String    @default("")
  note                   String    @default("")
  status                 String    @default("requested")
  totalCents             Int       @default(0)
  currency               String    @default("USD")
  sellerReply            String    @default("")
  replyProvider          String?
  replyProviderMessageId String?
  replyStatus            String?
  repliedAt              DateTime?
  inventoryApplied       Boolean   @default(false)
  statusTimelineJson     String    @default("[]")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, domain, createdAt])
  @@index([userId, status, createdAt])
  @@index([inquiryId])
}

model StoreEmailMessage {
  id                String   @id @default(uuid())
  userId            String
