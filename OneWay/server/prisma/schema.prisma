}

// ---------- Financial ledger core ------------------------------------------
//
// `accounts.balance` and `accounts.available_balance` remain as cached
// projections for now. The ledger tables below are the source of truth.

model LedgerAccount {
  id                   String   @id
  userId               String?  @map("user_id")
  balance              Int      @default(0)
  availableBalance     Int      @default(0) @map("available_balance")
  pendingBalance       Int      @default(0) @map("pending_balance")
  currency             String   @default("USD")
  status               String   @default("active")
  allowNegativeBalance Boolean  @default(false) @map("allow_negative_balance")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  transactions    LedgerTransaction[]
  entries         LedgerEntry[]
  reconciliations LedgerReconciliation[]

  @@index([userId])
  @@map("accounts")
}

model LedgerTransaction {
  id                     String    @id @default(uuid())
  accountId              String    @map("account_id")
  type                   String
  status                 String    @default("posted")
  amountCents            Int       @map("amount_cents")
  currency               String    @default("USD")
  externalId             String?   @unique @map("external_id")
  unitTxId               String?   @unique @map("unit_tx_id")
  stripeId               String?   @unique @map("stripe_id")
  reverseOfTransactionId String?   @map("reverse_of_transaction_id")
  metadataJson           String?   @map("metadata_json")
  createdAt              DateTime  @default(now()) @map("created_at")
  postedAt               DateTime? @map("posted_at")
  reversedAt             DateTime? @map("reversed_at")

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@index([accountId, createdAt])
  @@index([type, createdAt])
  @@index([reverseOfTransactionId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  accountId     String   @map("account_id")
  direction     String
  amountCents   Int      @map("amount_cents")
  balanceBucket String   @default("available") @map("balance_bucket")
  status        String   @default("posted")
  createdAt     DateTime @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, balanceBucket, status])
  @@index([transactionId])
  @@map("ledger_entries")
}

model LedgerReconciliation {
  id                        String   @id @default(uuid())
  accountId                 String   @map("account_id")
  cachedBalance             Int      @map("cached_balance")
  cachedAvailableBalance    Int      @map("cached_available_balance")
  projectedBalance          Int      @map("projected_balance")
  projectedAvailableBalance Int      @map("projected_available_balance")
  projectedPendingBalance   Int      @map("projected_pending_balance")
  mismatchCents             Int      @map("mismatch_cents")
  action                    String
  severity                  String
  detailsJson               String?  @map("details_json")
  createdAt                 DateTime @default(now()) @map("created_at")

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([severity, createdAt])
  @@map("ledger_reconciliations")
}

