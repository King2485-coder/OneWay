# OneWay API server — production env reference.
# Copy to .env and fill in real values. Never commit .env.

# ---- Core ----
NODE_ENV=production
PORT=3000
TRUST_PROXY=1
LOG_LEVEL=info
CORS_ORIGIN=https://oneway.is
API_BASE_URL=https://api.oneway.is
PUBLIC_BASE_URL=https://oneway.is
UPLOADS_PUBLIC_BASE_URL=https://cdn.oneway.app/uploads

# ---- Database (Postgres in prod; SQLite still works for `npm run dev`) ----
DATABASE_URL=postgres://oneway:CHANGE_ME@postgres:5432/oneway
# Docker compose uses a persisted SQLite file by default. Override only if needed.
DOCKER_DATABASE_URL=file:/app/data/dev.db
POSTGRES_USER=oneway
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=oneway

# ---- Redis ----
# Optional: leave unset to fall back to in-memory CallRegistry.
REDIS_URL=redis://redis:6379

# ---- Auth ----
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_HEX
JWT_TTL_SECONDS=604800
# Set to "true" to refuse the dev `Bearer dev:<userId>` auth path.
JWT_AUTH_REQUIRED=true
# Development only. Ignored when NODE_ENV=production.
ONEWAY_DEV_AUTH_TOKEN=
# Local development only. Used to seed password login for @king and @twinblixx.
# Do not commit a real password.
ONEWAY_DEV_TEST_PASSWORD=
# Optional. Used to sign short-lived live business-number claim confirmations.
# Defaults to JWT_SECRET when unset.
ONEWAY_NUMBER_PURCHASE_TOKEN_SECRET=
# Business number provider mode: auto uses Twilio when credentials exist,
# mock forces local test numbers in non-production, live refuses mock fallback.
ONEWAY_NUMBER_PROVIDER_MODE=auto
# Safety switch for live paid number claiming. Leave false until billing,
# legal approval, and customer confirmation are ready.
ONEWAY_LIVE_NUMBER_PURCHASES_ENABLED=false

# ---- LiveKit (token mint) ----
LIVEKIT_URL=wss://rtc.oneway.app
LIVEKIT_HOST=https://rtc.oneway.app
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx

# ---- TURN (HMAC ephemeral creds; same secret as turnserver.conf) ----
TURN_HOSTNAME=turn.oneway.app
TURN_SHARED_SECRET=CHANGE_ME_64_HEX
TURN_TTL_SECONDS=43200

# ---- APNs (VoIP push) ----
APNS_BUNDLE_ID=com.king.OneWay
APNS_ENVIRONMENT=production
APNS_KEY_ID=ABCD123456
APNS_TEAM_ID=ABCDEF7890
# Preferred for Railway: base64 of the complete Apple AuthKey_*.p8 file.
APNS_KEY_P8_BASE64=
# Alternative for hosts that mount the key as a file.
APNS_KEY_PATH=/etc/oneway/apns.p8
# OR cert-auth alternative:
# APNS_CERT_PATH=/etc/oneway/cert.pem
# APNS_KEY_PEM_PATH=/etc/oneway/key.pem

# ---- PSTN bridge ----
PSTN_PROVIDER=stub
# Keep false to preserve LiveKit SIP as the single production call path.
# Set true only for temporary controlled fallback testing.
PSTN_ENABLE_DIRECT_PROVIDER_FALLBACK=false
PSTN_FROM_NUMBER=+15551234567
# iOS/debug clients may use a LAN API URL, but Twilio must always receive this public HTTPS URL.
PUBLIC_WEBHOOK_BASE_URL=https://api.oneway.is
PSTN_WEBHOOK_BASE_URL=https://api.oneway.is
LIVEKIT_SIP_TRUNK_ID=
PSTN_CALLER_DISCLOSURE_ENABLED=true
PSTN_CALLER_DISCLOSURE_REQUIRE_ACCEPT=true
PSTN_CALLER_DISCLOSURE_BRAND=OneWay
# Optional for real app<->PSTN audio bridging (Twilio SIP leg -> LiveKit SIP)
# Template tokens: {roomName} {callSessionId} {toPhoneNumber}
PSTN_SIP_BRIDGE_URI_TEMPLATE=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SIP_TRUNK_SID=
TWILIO_FROM_NUMBER=

# ---- Stripe marketplace payments ----
# Never place real values in source control. Configure real values in the backend environment manager.
STRIPE_ENV=sandbox
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_CONNECT_REFRESH_URL=https://api.oneway.is/payments/refresh
STRIPE_CONNECT_RETURN_URL=https://api.oneway.is/payments/return
STRIPE_PORTAL_RETURN_URL=https://oneway.is/settings/billing
STRIPE_SUCCESS_URL=https://oneway.is/success
STRIPE_CANCEL_URL=https://oneway.is/cancel
ONEWAY_WEB_BASE_URL=https://oneway.is
ONEWAY_LIVE_CHECKOUT_ENABLED=false
ONEWAY_BILLING_GRACE_DAYS=7
STRIPE_TAX_ENABLED=false
STRIPE_PROMOTION_CODES_ENABLED=false

# Approved OneWay service catalog. Populate test-mode IDs first. Never copy
# sandbox IDs into live configuration.
+STRIPE_PRODUCT_ONEWAY_PRIVATE=\n+STRIPE_PRICE_ONEWAY_PRIVATE=\n+STRIPE_PRODUCT_ONEWAY_COMPLETE=\n+STRIPE_PRICE_ONEWAY_COMPLETE=\n+STRIPE_PRODUCT_ONEWAY_BUSINESS=\n+STRIPE_PRICE_ONEWAY_BUSINESS=\n+STRIPE_PRODUCT_ONEWAY_BUSINESS_PRO=\n+STRIPE_PRICE_ONEWAY_BUSINESS_PRO=\n+STRIPE_PRODUCT_PHONE_NUMBER=\n+STRIPE_PRICE_PHONE_NUMBER=\n+STRIPE_PRODUCT_PHONE_300=\n+STRIPE_PRICE_PHONE_300=\n+STRIPE_PRODUCT_PHONE_1000=\n+STRIPE_PRICE_PHONE_1000=\n+STRIPE_PRODUCT_SHOP_SLOT_1=\n+STRIPE_PRICE_SHOP_SLOT_1=\n+STRIPE_PRODUCT_SHOP_SLOT_10=\n+STRIPE_PRICE_SHOP_SLOT_10=\n+STRIPE_PRODUCT_SHOP_SLOT_25=\n+STRIPE_PRICE_SHOP_SLOT_25=\n+STRIPE_PRODUCT_SHOP_SLOT_50=\n+STRIPE_PRICE_SHOP_SLOT_50=\n+STRIPE_PRODUCT_SHOP_SLOT_100=\n+STRIPE_PRICE_SHOP_SLOT_100=\n+STRIPE_PRODUCT_ADDITIONAL_SHOP=\n+STRIPE_PRICE_ADDITIONAL_SHOP=

# ---- Internal OneWay Pricing Agent ----
# Admin-only access token for /api/admin/pricing. Use a distinct generated secret in production.
ONEWAY_PRICING_ADMIN_TOKEN=
# Monthly reconciliation runs on the 5th at 9:00 AM America/Phoenix and analyzes the previous calendar month.
PRICING_AGENT_JOB_ENABLED=true
# Live Stripe reads are locked off until test-mode reconciliation has been reviewed against Stripe Dashboard.
PRICING_AGENT_ALLOW_LIVE_READS=false

# Telnyx
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_SIP_TRUNK_ID=
TELNYX_FROM_NUMBER=

# Sinch
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=
SINCH_FROM_NUMBER=

# ---- SMS/MMS bridge ----
# Defaults to PSTN_PROVIDER when unset, then stub. Use twilio for the current
# OneWay external-line texting bridge.
SMS_PROVIDER=stub
SMS_FROM_NUMBER=
SMS_WEBHOOK_BASE_URL=https://api.oneway.is
# Set and append ?secret=<value> on provider webhook URLs in production.
SMS_WEBHOOK_SECRET=

# Twilio Messaging
TWILIO_MESSAGING_SERVICE_SID=MG73e55a4feab312f928f96a7891f08044
TWILIO_STATUS_CALLBACK_URL=https://api.oneway.is/api/twilio/message-status
TWILIO_INBOUND_WEBHOOK_URL=https://api.oneway.is/api/twilio/inbound-sms
# Optional override for campaign-status checks when Twilio's compliance SID changes.
TWILIO_A2P_COMPLIANCE_SID=
# Optional local/admin override: PENDING, IN_PROGRESS, VERIFIED, FAILED, etc.
TWILIO_A2P_CAMPAIGN_STATUS=

# Telnyx Messaging
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_MESSAGING_FROM_NUMBER=

# Sinch SMS
SINCH_SERVICE_PLAN_ID=
SINCH_API_TOKEN=
SINCH_SMS_FROM_NUMBER=
SINCH_SMS_REGION=us

# ---- OneWay Email + legacy external email bridge ----
# The hosted mailbox uses Mailgun's Messages API and signed inbound Routes.
# Keep live delivery false until the domain has verified MX/SPF/DKIM/DMARC,
# production encryption keys are loaded, and the external send/receive gate passes.
EMAIL_PROVIDER=stub
ONEWAY_EMAIL_DOMAIN=oneway.is
ONEWAY_EMAIL_LIVE_DELIVERY_ENABLED=false
# Restricted pre-launch delivery. Every To/Cc/Bcc recipient must appear in
# ONEWAY_EMAIL_VERIFICATION_RECIPIENTS, and attachments remain disabled.
ONEWAY_EMAIL_VERIFICATION_MODE=false
ONEWAY_EMAIL_VERIFICATION_RECIPIENTS=
ONEWAY_EMAIL_DAILY_SEND_LIMIT=100
ONEWAY_EMAIL_HOURLY_SEND_LIMIT=25
ONEWAY_EMAIL_MAX_ATTACHMENT_BYTES=25000000
ONEWAY_EMAIL_SPAM_SCORE_THRESHOLD=5
# Launch attestations remain false until each external gate is actually tested.
ONEWAY_EMAIL_DNS_VERIFIED=false
ONEWAY_EMAIL_INBOUND_VERIFIED=false
ONEWAY_EMAIL_GMAIL_DELIVERY_VERIFIED=false
ONEWAY_EMAIL_OUTLOOK_DELIVERY_VERIFIED=false
ONEWAY_EMAIL_BOUNCE_VERIFIED=false
ONEWAY_EMAIL_COMPLAINT_VERIFIED=false
ONEWAY_EMAIL_MALWARE_SCANNER_ENABLED=false
ONEWAY_EMAIL_PUSH_ENABLED=false
ONEWAY_EMAIL_TERMS_PUBLISHED=false
ONEWAY_EMAIL_SUPPORT_READY=false
ONEWAY_EMAIL_PRICING_COSTS_APPROVED=false
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=OneWay
EMAIL_REPLY_TO=
EMAIL_REPLY_DOMAIN=oneway.app
EMAIL_INBOUND_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_REPLY_TO_EMAIL=
SENDGRID_INBOUND_WEBHOOK_SECRET=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=oneway.is
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_API_BASE_URL=https://api.mailgun.net

# ---- Object storage (S3 or Cloudflare R2) ----
# Leave the S3_* vars unset to use local-disk storage instead.
S3_BUCKET=oneway-voicemail
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=AKIAxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxx
S3_RECORDINGS_BUCKET=oneway-recordings
S3_RECORDINGS_PUBLIC_BASE_URL=https://oneway-recordings.s3.us-east-1.amazonaws.com
# For Cloudflare R2:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL_BASE=https://media.oneway.app

# Required only when using LocalObjectStorage in multi-instance mode.
STORAGE_HMAC_SECRET=CHANGE_ME_64_HEX

# ---- Field-level encryption at rest ----
# Default off so existing local/dev records keep working. When enabled, provide
# 32-byte base64 keys. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_ENABLED=false
# Preferred multi-key registry for rotation. Keep old keys until all payloads
# have been rotated off them.
FIELD_ENCRYPTION_KEYS_JSON={"local-dev-v1":"CHANGE_ME_32_BYTE_BASE64","local-dev-v2":"CHANGE_ME_32_BYTE_BASE64"}
# Backward-compatible single-key setting. Used if FIELD_ENCRYPTION_KEYS_JSON is unset.
FIELD_ENCRYPTION_MASTER_KEY_BASE64=
FIELD_ENCRYPTION_KEY_ID=local-dev-v1
# Separate keyed lookup hash secret. Required in production when encrypted
# lookup hashes are needed for external conversations.
FIELD_HASH_KEY_BASE64=
FIELD_HASH_KEY_REQUIRED=true
ONEWAY_PRIVACY_ADMIN_TOKEN=
ONEWAY_AUDIT_ADMIN_TOKEN=
ONEWAY_SECURITY_ADMIN_TOKEN=
SECURITY_ALERT_EMAILS=
SECURITY_OPERATIONS_JOB_ENABLED=true
SECURITY_OPERATIONS_RUN_ON_STARTUP=false
SECURITY_OPERATIONS_INTERVAL_MS=86400000

# Optional helpers / legacy.
DEFAULT_DEV_USER_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SENTRY_DSN=

# OneWay Search crawler/indexer
# Enable with POST /api/search/crawl/start. Keep crawl jobs protected.
ONEWAY_SEARCH_ADMIN_TOKEN=CHANGE_ME_SEARCH_ADMIN_TOKEN
ONEWAY_SEARCH_SEEDS=https://www.wikipedia.org,https://developer.mozilla.org
ONEWAY_CRAWLER_USER_AGENT=OneWayBot/0.1 (+https://search.oneway.app/bot)
ONEWAY_CRAWLER_RESPECT_ROBOTS=true
ONEWAY_CRAWLER_DELAY_MS=1200
ONEWAY_CRAWLER_TIMEOUT_MS=10000
ONEWAY_CRAWLER_MAX_BYTES=1500000

# ---- OneWay Wallet / bank payments ----
# Keep disabled until a real regulated provider is wired and approved.
ONEWAY_BANK_ENABLED=false
# Non-production mock mode lets storefront checkout simulate OneWay Wallet payments.
ONEWAY_BANK_MOCK_MODE=true
ONEWAY_BANK_PRODUCTION_APPROVED=false
ONEWAY_BANK_API_URL=
ONEWAY_BANK_API_KEY=

# ---- Dormant OneWay Bank compliance layer ----
# Stripe/payment links remain the storefront production path while these are off.
COMPLIANCE_LAYER_ENABLED=false
LEDGER_ENABLED=false
RECONCILIATION_ENABLED=false
DISPUTES_ENABLED=false
MODERN_TREASURY_API_KEY=
MODERN_TREASURY_ORG_ID=
MODERN_TREASURY_WEBHOOK_KEY=
UNIT_BASE_URL=https://api.s.unit.sh
UNIT_API_TOKEN=
COMPLIANCE_EMAIL=
BSA_OFFICER_EMAIL=
BANK_PARTNER_NAME=
LEGAL_COMPLIANCE_REVIEW_REQUIRED=true

# ---- Ledger source-of-truth controls ----
# Admin token is required for ledger diagnostics in production. Dev auth can
# access these routes only when NODE_ENV !== production.
ONEWAY_LEDGER_ADMIN_TOKEN=
LEDGER_RECONCILIATION_JOB_ENABLED=false
LEDGER_RECONCILIATION_ACCOUNT_LIMIT=1000
LEDGER_AUTO_HEAL_THRESHOLD_CENTS=5

# ---- OneWay Ads controlled launch ----
ONEWAY_ADS_ENABLED=true
ONEWAY_ADS_ADVERTISER_CREATION_ENABLED=true
ONEWAY_ADS_CAMPAIGN_SUBMISSION_ENABLED=true
# Keep paid delivery false until internal QA, policy review, and billing approval are complete.
ONEWAY_ADS_PAID_DELIVERY_ENABLED=false
ONEWAY_ADS_INTERNAL_DELIVERY_ENABLED=false
ONEWAY_ADS_DELIVERY_TOKEN_SECRET=
ONEWAY_ADS_EVENT_TOKEN_SECRET=
ONEWAY_ADS_IMPRESSION_VERIFICATION_ENABLED=true
ONEWAY_ADS_CLICK_VERIFICATION_ENABLED=true
ONEWAY_ADS_SPEND_ACCOUNTING_ENABLED=true
ONEWAY_ADS_IMPRESSION_BILLING_ENABLED=true
ONEWAY_ADS_CLICK_BILLING_ENABLED=true
ONEWAY_ADS_CONVERSION_TRACKING_ENABLED=false
ONEWAY_ADS_MIN_BUDGET_MINOR=500
ONEWAY_ADS_CPM_PRICE_MINOR=500
ONEWAY_ADS_CPC_PRICE_MINOR=25
ONEWAY_ADS_FREQ_CAMPAIGN_HOUR=2
ONEWAY_ADS_FREQ_CAMPAIGN_DAY=5
ONEWAY_ADS_FREQ_ADVERTISER_DAY=12
ONEWAY_ADS_HIDE_COOLDOWN_MINUTES=1440
ONEWAY_ADS_SUPPORTED_COUNTRIES=US
