# OneWay API server — production env reference.
# Copy to .env and fill in real values. Never commit .env.

# ---- Core ----
NODE_ENV=production
PORT=3000
TRUST_PROXY=1
LOG_LEVEL=info
CORS_ORIGIN=https://oneway.app
UPLOADS_PUBLIC_BASE_URL=https://cdn.oneway.app/uploads

# ---- Database (Postgres in prod; SQLite still works for `npm run dev`) ----
DATABASE_URL=postgres://oneway:CHANGE_ME@postgres:5432/oneway
POSTGRES_USER=oneway
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=oneway

# ---- Redis ----
# Optional: leave unset to fall back to in-memory CallRegistry.
REDIS_URL=redis://redis:6379

# ---- Auth ----
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_HEX
JWT_TTL_SECONDS=604800
# Set to "true" to refuse the dev `Bearer dev:<userId>` auth path.
JWT_AUTH_REQUIRED=true

# ---- LiveKit (token mint) ----
LIVEKIT_URL=wss://rtc.oneway.app
LIVEKIT_HOST=https://rtc.oneway.app
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx

# ---- TURN (HMAC ephemeral creds; same secret as turnserver.conf) ----
TURN_HOSTNAME=turn.oneway.app
TURN_SHARED_SECRET=CHANGE_ME_64_HEX
TURN_TTL_SECONDS=43200

# ---- APNs (VoIP push) ----
APNS_BUNDLE_ID=com.onewayapp.OneWay
APNS_ENVIRONMENT=production
APNS_KEY_ID=ABCD123456
APNS_TEAM_ID=ABCDEF7890
APNS_KEY_PATH=/etc/oneway/apns.p8
# OR cert-auth alternative:
# APNS_CERT_PATH=/etc/oneway/cert.pem
# APNS_KEY_PEM_PATH=/etc/oneway/key.pem

# ---- Object storage (S3 or Cloudflare R2) ----
# Leave the S3_* vars unset to use local-disk storage instead.
S3_BUCKET=oneway-voicemail
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=AKIAxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxx
S3_RECORDINGS_BUCKET=oneway-recordings
S3_RECORDINGS_PUBLIC_BASE_URL=https://oneway-recordings.s3.us-east-1.amazonaws.com
# For Cloudflare R2:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL_BASE=https://media.oneway.app

# Required only when using LocalObjectStorage in multi-instance mode.
STORAGE_HMAC_SECRET=CHANGE_ME_64_HEX

# Optional helpers / legacy.
DEFAULT_DEV_USER_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SENTRY_DSN=

# ---- Commerce / Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://oneway.app/success
STRIPE_CANCEL_URL=https://oneway.app/cancel
